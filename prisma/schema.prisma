// Contractor OS — Canonical Domain Model
// Source of truth is the structured domain model, NOT Office files.
// Estimate is the canonical commercial object; BOQ is a projection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy & Identity
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id            String   @id @default(cuid())
  name          String
  industryPackId String  @default("construction-ghana")
  currency      String   @default("GHS")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  clients       Client[]
  opportunities Opportunity[]
  workDefinitions WorkDefinition[]
  resources     Resource[]
  estimates     Estimate[]
  bids          Bid[]
  auditLogs     AuditLog[]
  knowledgeAlerts KnowledgeAlert[]
  commercialExceptions CommercialException[]
  projectActuals   ProjectActual[]
  calibrationProposals CalibrationProposal[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  role           String   @default("estimator") // estimator | manager | director | admin
  passwordHash   String?
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  opportunities  Opportunity[] @relation("OpportunityOwner")
  auditLogs      AuditLog[]
}

// Users who signed up and are waiting for an admin to create their account.
// Sign-up does NOT create a User — it creates a WaitlistEntry.
model WaitlistEntry {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  company      String?
  role         String   @default("estimator") // requested role
  status       String   @default("pending") // pending | approved | rejected
  notes        String?
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  createdUserId String? // the User created when approved
}

// ─────────────────────────────────────────────────────────────────────────────
// Clients
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  sector         String?  // public | private | ngo
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  opportunities  Opportunity[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Opportunity / RFQ
// ─────────────────────────────────────────────────────────────────────────────

model Opportunity {
  id                 String   @id @default(cuid())
  organizationId     String
  clientId           String
  ownerId            String?
  title              String
  reference          String?
  status             String   @default("received")
  // received | qualifying | no-bid | scope-development | estimating |
  // internal-review | adjudication | submitted | clarification | won | lost |
  // withdrawn | lapsed
  source             String?  // direct | tender-portal | referral
  description        String?
  receivedAt         DateTime @default(now())
  submissionDeadline DateTime?
  location           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id])
  client             Client       @relation(fields: [clientId], references: [id])
  owner              User?        @relation("OpportunityOwner", fields: [ownerId], references: [id])
  scopePackage       ScopePackage?
  estimates          Estimate[]
  subcontractPackages SubcontractPackage[]
  bid                Bid?
}

// ─────────────────────────────────────────────────────────────────────────────
// Scope — first-class domain object
// ─────────────────────────────────────────────────────────────────────────────

model ScopePackage {
  id             String   @id @default(cuid())
  opportunityId  String   @unique
  completeness   Float    @default(0) // 0..1 deterministic score
  origin         String   @default("rfq") // rfq | client-boq | estimator | site | ai
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  items          ScopeItem[]
  questions      ScopeQuestion[]
  assumptions    ScopeAssumption[]
  evidence       ScopeEvidence[]
}

model ScopeItem {
  id              String   @id @default(cuid())
  scopePackageId  String
  description     String
  category        String?  // structural | roofing | finishes | mep | external | etc.
  origin          String   @default("client") // client | inferred | ai | estimator
  status          String   @default("known") // known | missing | ambiguous
  confidence      Float    @default(1)
  createdAt       DateTime @default(now())

  scopePackage    ScopePackage @relation(fields: [scopePackageId], references: [id])
  estimateLines   EstimateLine[]
}

model ScopeQuestion {
  id                String   @id @default(cuid())
  scopePackageId    String
  question          String
  category          String?
  interpretationA   String?
  interpretationB   String?
  selectedInterpretation String?
  costImpact        Float    @default(0)
  programmeImpact   Float    @default(0) // days
  safetyImpact      String?
  contractualImpact String?
  status            String   @default("open") // open | clarified | assumed | resolved
  resolution        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  scopePackage      ScopePackage @relation(fields: [scopePackageId], references: [id])
}

model ScopeAssumption {
  id             String   @id @default(cuid())
  scopePackageId String
  text           String
  rationale      String?
  riskLevel      String   @default("medium") // low | medium | high
  acknowledged   Boolean  @default(false)
  createdAt      DateTime @default(now())

  scopePackage   ScopePackage @relation(fields: [scopePackageId], references: [id])
}

model ScopeEvidence {
  id             String   @id @default(cuid())
  scopePackageId String
  type           String   // rfq | drawing | specification | client-boq | photo | email | note | ai-extraction
  reference      String?
  summary        String
  createdAt      DateTime @default(now())

  scopePackage   ScopePackage @relation(fields: [scopePackageId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Work Library — institutional memory (versioned, immutable when approved)
// ─────────────────────────────────────────────────────────────────────────────

model WorkDefinition {
  id             String   @id @default(cuid())
  organizationId String
  code           String   // e.g. "WD-STRUCT-014"
  name           String
  industry       String   @default("construction")
  category       String?  // structural | roofing | masonry | finishes | mep
  unit           String   // m2 | m3 | m | nr | ton
  approvalState  String   @default("draft") // draft | in-review | approved | deprecated
  currentVersionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id])
  versions       WorkDefinitionVersion[]
  estimateLines  EstimateLine[]
  calibrationProposals CalibrationProposal[]
}

model WorkDefinitionVersion {
  id                  String   @id @default(cuid())
  workDefinitionId    String
  version             Int      @default(1)
  measurementRule     String?
  costRecipeJson      String   // deterministic recipe (resource quantities + wastage)
  productivityRule    Float?   // output per crew-day
  crewComposition     String?
  equipment           String?
  wastage             Float    @default(0.05)
  sequencing          String?
  methodStatementFragment String?
  hazardsJson         String   // array of hazard strings
  controlsJson        String   // array of control strings
  qualityChecklistJson String
  requiredPPE         String?
  requiredPermits     String?
  subcontractability  String   @default("yes") // yes | no | partial
  commonAssumptions   String?
  commonExclusions    String?
  approvalState       String   @default("draft") // draft | approved
  approvedAt          DateTime?
  approvedById        String?
  createdAt           DateTime @default(now())

  workDefinition      WorkDefinition @relation(fields: [workDefinitionId], references: [id])
  estimateLines       EstimateLine[]
  priceObservations   ResourcePriceObservation[] @relation("PriceObservationWDV")
}

// ─────────────────────────────────────────────────────────────────────────────
// Resources & Price Provenance (append-only observations)
// ─────────────────────────────────────────────────────────────────────────────

model Resource {
  id             String   @id @default(cuid())
  organizationId String
  code           String   // e.g. "RES-MAT-CEM"
  name           String
  unit           String
  kind           String   // labour | material | plant | subcontract | fee
  currency       String   @default("GHS")
  region         String?  // e.g. "Greater Accra"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  priceObservations ResourcePriceObservation[]
}

model ResourcePriceObservation {
  id                       String   @id @default(cuid())
  resourceId               String
  workDefinitionVersionId  String?
  price                    Float
  currency                 String   @default("GHS")
  provenance               String   // supplier-quote | invoice | market-survey | manual | historical-bid | subcontract-quote
  sourceReference          String?  // quote #, invoice #, etc.
  observedAt               DateTime @default(now())
  recordedById             String?
  createdAt                DateTime @default(now())

  resource                 Resource              @relation(fields: [resourceId], references: [id])
  workDefinitionVersion    WorkDefinitionVersion? @relation("PriceObservationWDV", fields: [workDefinitionVersionId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Estimate — the canonical commercial object
// ─────────────────────────────────────────────────────────────────────────────

model Estimate {
  id             String   @id @default(cuid())
  organizationId String
  opportunityId  String
  version        Int      @default(1)
  status         String   @default("draft") // draft | internal-review | adjudicated | submitted | superseded
  overheadPct    Float    @default(0.10)
  profitPct      Float    @default(0.12)
  contingencyPct Float    @default(0.05)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id])
  lines          EstimateLine[]
  revisions      EstimateRevision[]
  bid            Bid?
}

model EstimateRevision {
  id            String   @id @default(cuid())
  estimateId    String
  revisionNo    Int
  snapshotJson  String   // immutable snapshot of lines + pricing inputs (P0-6 reproducibility)
  status        String   @default("finalized") // finalized (immutable) — only finalized revisions can be referenced by a Bid
  finalizedAt   DateTime @default(now())
  finalizedById String?

  estimate      Estimate @relation(fields: [estimateId], references: [id])

  @@unique([estimateId, revisionNo])
}

model EstimateLine {
  id                    String   @id @default(cuid())
  estimateId            String
  scopeItemId           String?
  workDefinitionId      String?
  workDefinitionVersionId String?
  description           String
  quantity              Float
  unit                  String
  executionStrategy     String   @default("self-perform") // self-perform | subcontract | hybrid | undecided
  // Calculation status — 'incomplete' means the price is provisional and
  // cannot be committed to a finalized estimate (P0-4 fix).
  calculationStatus     String   @default("complete") // complete | incomplete
  blockingInputsJson    String   @default("[]") // [{kind:'missing-price',resourceName}]
  // Cost build-up (deterministic, computed by pricing-engine on write)
  materialCost          Float    @default(0)
  labourCost            Float    @default(0)
  plantCost             Float    @default(0)
  subcontractCost       Float    @default(0)
  directCost            Float    @default(0)
  projectCost           Float    @default(0) // direct + project-specific
  riskCost              Float    @default(0)
  overheadCost          Float    @default(0)
  profitCost            Float    @default(0)
  estimatedTotalCost    Float    @default(0) // direct + risk + overhead (excludes profit)
  expectedProfit        Float    @default(0) // sellPrice - estimatedTotalCost
  sellPrice             Float    @default(0)
  unitRate              Float    @default(0)
  expectedMarginPct     Float    @default(0) // expectedProfit / sellPrice (P0-6 fix)
  marginPct             Float    @default(0) // legacy alias kept for backward-compat reads
  confidence            Float    @default(0.5) // 0..1 derived from evidence
  provenanceSummary     String?  // human-readable lineage
  isUnsourced           Boolean  @default(false)
  unsourcedRationale    String?
  unsourcedConfidence   Float?
  acknowledged          Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  estimate              Estimate              @relation(fields: [estimateId], references: [id])
  scopeItem             ScopeItem?            @relation(fields: [scopeItemId], references: [id])
  workDefinition        WorkDefinition?       @relation(fields: [workDefinitionId], references: [id])
  workDefinitionVersion WorkDefinitionVersion? @relation(fields: [workDefinitionVersionId], references: [id])
  subcontractPackageLine SubcontractPackageLine[]
  executionSegments     ExecutionSegment[]
  commercialExceptions  CommercialException[]
  actuals               ProjectActual[]
}

// P0-5 fix: hybrid execution needs explicit allocation, never a 50% heuristic.
// An EstimateLine with strategy 'hybrid' must have ≥2 segments summing to 100%.
// Missing allocation → calculationStatus = 'incomplete'.
model ExecutionSegment {
  id            String   @id @default(cuid())
  estimateLineId String
  strategy      String   // self-perform | subcontract
  scopeDefinition String
  quantityPct   Float    @default(1.0) // 0..1 share of the line's quantity
  subcontractQuoteId String?
  // P0-1/P0-2: Persisted commercial state — the pricing engine consumes these.
  // Without them, the commercial decision is ephemeral and not reproducible.
  pricingBasis  String?  // direct-segment-quote | proportional-from-package
  quoteCoversSegmentScope Boolean @default(false) // approved reconciliation result
  createdAt     DateTime @default(now())

  estimateLine  EstimateLine @relation(fields: [estimateLineId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Subcontracting — execution strategy + scope reconciliation
// ─────────────────────────────────────────────────────────────────────────────

model SubcontractPackage {
  id             String   @id @default(cuid())
  organizationId String
  opportunityId  String
  name           String
  scope          String?
  executionStrategy String @default("subcontract")
  status         String   @default("draft") // draft | enquiry-sent | quotes-received | awarded | abandoned
  selectedQuoteId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  lines          SubcontractPackageLine[]
  quotes         SubcontractQuote[]
  scopeAtoms     ScopeAtom[]
}

model SubcontractPackageLine {
  id                   String @id @default(cuid())
  subcontractPackageId String
  estimateLineId       String
  requiredScope        String
  createdAt            DateTime @default(now())

  subcontractPackage   SubcontractPackage @relation(fields: [subcontractPackageId], references: [id])
  estimateLine         EstimateLine       @relation(fields: [estimateLineId], references: [id])
}

model SubcontractQuote {
  id                   String   @id @default(cuid())
  subcontractPackageId String
  supplierName         String
  totalAmount          Float
  currency             String   @default("GHS")
  receivedAt           DateTime @default(now())
  exclusionsJson       String   @default("[]")
  assumptionsJson      String   @default("[]")
  coveragePct          Float    @default(0) // 0..1 reconciled coverage
  status               String   @default("received") // received | selected | rejected
  createdAt            DateTime @default(now())

  subcontractPackage   SubcontractPackage @relation(fields: [subcontractPackageId], references: [id])
  lines                SubcontractQuoteLine[]
  scopeCoverages       QuoteScopeCoverage[]
}

model SubcontractQuoteLine {
  id              String   @id @default(cuid())
  quoteId         String
  description     String
  amount          Float
  currency        String   @default("GHS")

  quote           SubcontractQuote @relation(fields: [quoteId], references: [id])
}

// P0-7 fix: scope reconciliation based on structured scope atoms, not substring.
// A SubcontractPackage defines required ScopeAtoms (e.g. manufacture, delivery,
// installation). Each quote explicitly covers/excludes each atom.
model ScopeAtom {
  id                   String   @id @default(cuid())
  subcontractPackageId String
  name                 String   // e.g. "installation"
  description          String?
  // P0-1 fix: economic weight for this atom (0..1). Enables economic coverage
  // = sum(covered atom weights) / sum(all atom weights), distinct from semantic
  // coverage = covered atoms / total atoms. If all weights are equal (or 0),
  // economic coverage falls back to semantic coverage.
  valueWeight          Float    @default(0)
  createdAt            DateTime @default(now())

  subcontractPackage   SubcontractPackage @relation(fields: [subcontractPackageId], references: [id])
  coverages            QuoteScopeCoverage[]
}

model QuoteScopeCoverage {
  id            String   @id @default(cuid())
  quoteId       String
  scopeAtomId   String
  // covered | excluded | unstated. 'unstated' = quote didn't address this atom.
  status        String   @default("unstated")
  note          String?
  createdAt     DateTime @default(now())

  quote         SubcontractQuote @relation(fields: [quoteId], references: [id])
  scopeAtom     ScopeAtom        @relation(fields: [scopeAtomId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Bid — submission + outcome (reproducible from immutable revisions)
// ─────────────────────────────────────────────────────────────────────────────

model Bid {
  id                  String   @id @default(cuid())
  organizationId      String
  opportunityId       String   @unique
  estimateId          String   @unique
  estimateRevisionId  String?
  adjudicatedRevisionId String? // P0-4: the revision used for adjudication (must match submitted revision)
  programmeRevisionId String?
  tenderPackStatus    String   @default("draft") // draft | ready | submitted | won | lost | withdrawn
  finalPrice          Float?
  directorAdjustment  Float    @default(0)
  adjustmentRationale String?
  systemSellPrice     Float?   // P0-4: frozen system price at adjudication time (from revision snapshot)
  submittedAt         DateTime?
  outcome             String?  // won | lost | withdrawn | unknown
  lossReason          String?  // price | programme | technical | prequalification | relationship | unknown
  winningPrice        Float?
  ourRank             Int?
  clientFeedback      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id])
  opportunity         Opportunity  @relation(fields: [opportunityId], references: [id])
  estimate            Estimate    @relation(fields: [estimateId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log — append-only
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String   // estimate.created | rate.changed | bid.submitted | etc.
  entityType     String
  entityId       String
  beforeJson     String?
  afterJson      String?
  summary        String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User?        @relation(fields: [actorId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Knowledge Health — stale/unreliable knowledge surfacing
// ─────────────────────────────────────────────────────────────────────────────

model KnowledgeAlert {
  id             String   @id @default(cuid())
  organizationId String
  type           String   // stale-price | productivity-variance | unapproved-rate | scope-gap | subcontract-exclusion
  severity       String   @default("warning") // info | warning | blocker
  title          String
  detail         String?
  entityId       String?
  entityType     String?
  acknowledged   Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Commercial Exceptions (P0-8 fix) — auditable, not a bare boolean.
// An unsourced rate, an incomplete calculation, or any commercial override
// must be recorded with who/when/why and (for high-value) director approval.
// ─────────────────────────────────────────────────────────────────────────────

model CommercialException {
  id              String   @id @default(cuid())
  organizationId  String
  estimateLineId  String?
  entityType      String   // estimate-line | subcontract-quote | assumption
  entityId        String?
  type            String   // unsourced-rate | incomplete-calculation | hybrid-without-allocation | missing-quote | other
  reason          String
  exposure        Float    @default(0) // GHS value at risk
  acknowledgedById String?
  acknowledgedAt  DateTime?
  approvalRequired Boolean @default(false)
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])
  estimateLine    EstimateLine? @relation(fields: [estimateLineId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Knowledge Loop (P1-12) — actuals → variance → calibration proposal
// ─────────────────────────────────────────────────────────────────────────────

model ProjectActual {
  id              String   @id @default(cuid())
  organizationId  String
  estimateLineId  String
  // Actuals captured after execution
  quantityCompleted Float   @default(0)
  daysTaken        Float    @default(0)
  crewSize         Float    @default(0)
  materialConsumed Float    @default(0)
  materialCost     Float    @default(0)
  subcontractFinalCost Float @default(0)
  // Computed variance (planned vs actual)
  plannedProductivity Float  @default(0) // qty / crew-day
  actualProductivity  Float  @default(0)
  productivityVariance Float @default(0) // (actual - planned) / planned
  plannedCost      Float    @default(0)
  actualCost       Float    @default(0)
  costVariance     Float    @default(0) // (actual - planned) / planned
  recordedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])
  estimateLine    EstimateLine @relation(fields: [estimateLineId], references: [id])
  calibrationProposals CalibrationProposal[]
}

model CalibrationProposal {
  id                     String   @id @default(cuid())
  organizationId         String
  workDefinitionId       String
  projectActualId        String?
  type                   String   // productivity-update | price-update | method-update
  currentValue           String
  proposedValue          String
  rationale              String
  status                 String   @default("pending") // pending | approved | rejected | applied
  reviewedById           String?
  reviewedAt             DateTime?
  createdAt              DateTime @default(now())

  organization           Organization @relation(fields: [organizationId], references: [id])
  workDefinition         WorkDefinition @relation(fields: [workDefinitionId], references: [id])
  projectActual          ProjectActual? @relation(fields: [projectActualId], references: [id])
}
