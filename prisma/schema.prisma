// Contractor OS — Canonical Domain Model
// Source of truth is the structured domain model, NOT Office files.
// Estimate is the canonical commercial object; BOQ is a projection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy & Identity
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id            String   @id @default(cuid())
  name          String
  industryPackId String  @default("construction-ghana")
  currency      String   @default("GHS")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  clients       Client[]
  opportunities Opportunity[]
  workDefinitions WorkDefinition[]
  resources     Resource[]
  estimates     Estimate[]
  bids          Bid[]
  auditLogs     AuditLog[]
  knowledgeAlerts KnowledgeAlert[]
  commercialExceptions CommercialException[]
  projectActuals   ProjectActual[]
  calibrationProposals CalibrationProposal[]
  documents      Document[]
  productivityObservations ProductivityObservation[]
  boqImports     BoqImport[]
  programmes     Programme[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  role           String   @default("estimator") // estimator | manager | director | admin
  passwordHash   String?
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  opportunities  Opportunity[] @relation("OpportunityOwner")
  auditLogs      AuditLog[]
}

// Users who signed up and are waiting for an admin to create their account.
// Sign-up does NOT create a User — it creates a WaitlistEntry.
model WaitlistEntry {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  company      String?
  role         String   @default("estimator") // requested role
  status       String   @default("pending") // pending | approved | rejected
  notes        String?
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  createdUserId String? // the User created when approved
}

// ─────────────────────────────────────────────────────────────────────────────
// Clients
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  sector         String?  // public | private | ngo
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  opportunities  Opportunity[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Opportunity / RFQ
// ─────────────────────────────────────────────────────────────────────────────

model Opportunity {
  id                 String   @id @default(cuid())
  organizationId     String
  clientId           String
  ownerId            String?
  title              String
  reference          String?
  status             String   @default("received")
  // received | qualifying | no-bid | scope-development | estimating |
  // internal-review | adjudication | submitted | clarification | won | lost |
  // withdrawn | lapsed
  source             String?  // direct | tender-portal | referral
  description        String?
  receivedAt         DateTime @default(now())
  submissionDeadline DateTime?
  location           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id])
  client             Client       @relation(fields: [clientId], references: [id])
  owner              User?        @relation("OpportunityOwner", fields: [ownerId], references: [id])
  scopePackage       ScopePackage?
  estimates          Estimate[]
  subcontractPackages SubcontractPackage[]
  bid                Bid?
  documents          Document[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Scope — first-class domain object
// ─────────────────────────────────────────────────────────────────────────────

model ScopePackage {
  id             String   @id @default(cuid())
  opportunityId  String   @unique
  completeness   Float    @default(0) // 0..1 deterministic score
  origin         String   @default("rfq") // rfq | client-boq | estimator | site | ai
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  items          ScopeItem[]
  questions      ScopeQuestion[]
  assumptions    ScopeAssumption[]
  evidence       ScopeEvidence[]
}

model ScopeItem {
  id              String   @id @default(cuid())
  scopePackageId  String
  description     String
  category        String?  // structural | roofing | finishes | mep | external | etc.
  origin          String   @default("client") // client | inferred | ai | estimator
  status          String   @default("known") // known | missing | ambiguous
  confidence      Float    @default(1)
  createdAt       DateTime @default(now())

  scopePackage    ScopePackage @relation(fields: [scopePackageId], references: [id])
  estimateLines   EstimateLine[]
}

model ScopeQuestion {
  id                String   @id @default(cuid())
  scopePackageId    String
  question          String
  category          String?
  interpretationA   String?
  interpretationB   String?
  selectedInterpretation String?
  costImpact        Float    @default(0)
  programmeImpact   Float    @default(0) // days
  safetyImpact      String?
  contractualImpact String?
  status            String   @default("open") // open | clarified | assumed | resolved
  resolution        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  scopePackage      ScopePackage @relation(fields: [scopePackageId], references: [id])
}

model ScopeAssumption {
  id             String   @id @default(cuid())
  scopePackageId String
  text           String
  rationale      String?
  riskLevel      String   @default("medium") // low | medium | high
  acknowledged   Boolean  @default(false)
  createdAt      DateTime @default(now())

  scopePackage   ScopePackage @relation(fields: [scopePackageId], references: [id])
}

model ScopeEvidence {
  id             String   @id @default(cuid())
  scopePackageId String
  type           String   // rfq | drawing | specification | client-boq | photo | email | note | ai-extraction
  reference      String?
  summary        String
  createdAt      DateTime @default(now())

  scopePackage   ScopePackage @relation(fields: [scopePackageId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Work Library — institutional memory (versioned, immutable when approved)
// ─────────────────────────────────────────────────────────────────────────────

model WorkDefinition {
  id             String   @id @default(cuid())
  organizationId String
  code           String   // e.g. "WD-STRUCT-014"
  name           String
  industry       String   @default("construction")
  category       String?  // structural | roofing | masonry | finishes | mep
  unit           String   // m2 | m3 | m | nr | ton
  approvalState  String   @default("draft") // draft | in-review | approved | deprecated
  currentVersionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id])
  versions       WorkDefinitionVersion[]
  estimateLines  EstimateLine[]
  calibrationProposals CalibrationProposal[]
}

model WorkDefinitionVersion {
  id                  String   @id @default(cuid())
  workDefinitionId    String
  version             Int      @default(1)
  measurementRule     String?
  costRecipeJson      String   // deterministic recipe (resource quantities + wastage)
  productivityRule    Float?   // output per crew-day
  crewComposition     String?
  equipment           String?
  wastage             Float    @default(0.05)
  sequencing          String?
  methodStatementFragment String?
  hazardsJson         String   // array of hazard strings
  controlsJson        String   // array of control strings
  qualityChecklistJson String
  requiredPPE         String?
  requiredPermits     String?
  subcontractability  String   @default("yes") // yes | no | partial
  commonAssumptions   String?
  commonExclusions    String?
  approvalState       String   @default("draft") // draft | approved
  approvedAt          DateTime?
  approvedById        String?
  createdAt           DateTime @default(now())

  workDefinition      WorkDefinition @relation(fields: [workDefinitionId], references: [id])
  estimateLines       EstimateLine[]
  priceObservations   ResourcePriceObservation[] @relation("PriceObservationWDV")
  productivityObservations ProductivityObservation[]
  programmeActivities Activity[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Productivity Observations — append-only actuals from executed work
// ─────────────────────────────────────────────────────────────────────────────

model ProductivityObservation {
  id                      String   @id @default(cuid())
  organizationId          String
  workDefinitionVersionId String
  quantityCompleted       Float    // actual quantity completed
  daysTaken               Float    // actual crew-days taken
  crewSize                Float    // actual crew size
  actualProductivity      Float    // quantityCompleted / daysTaken (computed)
  plannedProductivity     Float    // from WDV.productivityRule (snapshot for variance)
  variancePct             Float    // (actual - planned) / planned (computed)
  sourceReference         String?  // project name, bid ID, etc.
  observedAt              DateTime @default(now())
  recordedById            String?
  createdAt               DateTime @default(now())

  organization            Organization @relation(fields: [organizationId], references: [id])
  workDefinitionVersion   WorkDefinitionVersion @relation(fields: [workDefinitionVersionId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Resources & Price Provenance (append-only observations)
// ─────────────────────────────────────────────────────────────────────────────

model Resource {
  id             String   @id @default(cuid())
  organizationId String
  code           String   // e.g. "RES-MAT-CEM"
  name           String
  unit           String
  kind           String   // labour | material | plant | subcontract | fee
  currency       String   @default("GHS")
  region         String?  // e.g. "Greater Accra"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  priceObservations ResourcePriceObservation[]
}

model ResourcePriceObservation {
  id                       String   @id @default(cuid())
  resourceId               String
  workDefinitionVersionId  String?
  price                    Float
  currency                 String   @default("GHS")
  provenance               String   // supplier-quote | invoice | market-survey | manual | historical-bid | subcontract-quote
  sourceReference          String?  // quote #, invoice #, etc.
  observedAt               DateTime @default(now())
  recordedById             String?
  createdAt                DateTime @default(now())

  resource                 Resource              @relation(fields: [resourceId], references: [id])
  workDefinitionVersion    WorkDefinitionVersion? @relation("PriceObservationWDV", fields: [workDefinitionVersionId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Estimate — the canonical commercial object
// ─────────────────────────────────────────────────────────────────────────────

model Estimate {
  id             String   @id @default(cuid())
  organizationId String
  opportunityId  String
  version        Int      @default(1)
  status         String   @default("draft") // draft | internal-review | adjudicated | submitted | superseded
  overheadPct    Float    @default(0.10)
  profitPct      Float    @default(0.12)
  contingencyPct Float    @default(0.05)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id])
  lines          EstimateLine[]
  revisions      EstimateRevision[]
  bid            Bid?
}

model EstimateRevision {
  id            String   @id @default(cuid())
  estimateId    String
  revisionNo    Int
  snapshotJson  String   // immutable snapshot of lines + pricing inputs (P0-6 reproducibility)
  status        String   @default("finalized") // finalized (immutable) — only finalized revisions can be referenced by a Bid
  revisionType  String   @default("estimate") // estimate | programme — distinguishes commercial vs programme revisions
  finalizedAt   DateTime @default(now())
  finalizedById String?

  estimate      Estimate @relation(fields: [estimateId], references: [id])

  @@unique([estimateId, revisionNo])
}

model EstimateLine {
  id                    String   @id @default(cuid())
  estimateId            String
  scopeItemId           String?
  workDefinitionId      String?
  workDefinitionVersionId String?
  description           String
  quantity              Float
  unit                  String
  executionStrategy     String   @default("self-perform") // self-perform | subcontract | hybrid | undecided
  // Calculation status — 'incomplete' means the price is provisional and
  // cannot be committed to a finalized estimate (P0-4 fix).
  calculationStatus     String   @default("complete") // complete | incomplete
  blockingInputsJson    String   @default("[]") // [{kind:'missing-price',resourceName}]
  // Cost build-up (deterministic, computed by pricing-engine on write)
  materialCost          Float    @default(0)
  labourCost            Float    @default(0)
  plantCost             Float    @default(0)
  subcontractCost       Float    @default(0)
  feeCost               Float    @default(0) // permits, levies, fees — part of directCost
  directCost            Float    @default(0)
  projectCost           Float    @default(0) // direct + project-specific
  riskCost              Float    @default(0)
  overheadCost          Float    @default(0)
  profitCost            Float    @default(0)
  estimatedTotalCost    Float    @default(0) // direct + risk + overhead (excludes profit)
  expectedProfit        Float    @default(0) // sellPrice - estimatedTotalCost
  sellPrice             Float    @default(0)
  unitRate              Float    @default(0)
  expectedMarginPct     Float    @default(0) // expectedProfit / sellPrice (P0-6 fix)
  marginPct             Float    @default(0) // legacy alias kept for backward-compat reads
  confidence            Float    @default(0.5) // 0..1 derived from evidence
  provenanceSummary     String?  // human-readable lineage
  isUnsourced           Boolean  @default(false)
  unsourcedRationale    String?
  unsourcedConfidence   Float?
  acknowledged          Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  estimate              Estimate              @relation(fields: [estimateId], references: [id])
  scopeItem             ScopeItem?            @relation(fields: [scopeItemId], references: [id])
  workDefinition        WorkDefinition?       @relation(fields: [workDefinitionId], references: [id])
  workDefinitionVersion WorkDefinitionVersion? @relation(fields: [workDefinitionVersionId], references: [id])
  subcontractPackageLine SubcontractPackageLine[]
  executionSegments     ExecutionSegment[]
  commercialExceptions  CommercialException[]
  actuals               ProjectActual[]
  boqBindings           BoqBinding[]
  programmeActivities   Activity[]
}

// P0-5 fix: hybrid execution needs explicit allocation, never a 50% heuristic.
// An EstimateLine with strategy 'hybrid' must have ≥2 segments summing to 100%.
// Missing allocation → calculationStatus = 'incomplete'.
model ExecutionSegment {
  id            String   @id @default(cuid())
  estimateLineId String
  strategy      String   // self-perform | subcontract
  scopeDefinition String
  quantityPct   Float    @default(1.0) // 0..1 share of the line's quantity
  subcontractQuoteId String?
  // P0-1/P0-2: Persisted commercial state — the pricing engine consumes these.
  // Without them, the commercial decision is ephemeral and not reproducible.
  pricingBasis  String?  // direct-segment-quote | proportional-from-package
  quoteCoversSegmentScope Boolean @default(false) // approved reconciliation result
  createdAt     DateTime @default(now())

  estimateLine  EstimateLine @relation(fields: [estimateLineId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Subcontracting — execution strategy + scope reconciliation
// ─────────────────────────────────────────────────────────────────────────────

model SubcontractPackage {
  id             String   @id @default(cuid())
  organizationId String
  opportunityId  String
  name           String
  scope          String?
  executionStrategy String @default("subcontract")
  status         String   @default("draft") // draft | enquiry-sent | quotes-received | awarded | abandoned
  selectedQuoteId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  lines          SubcontractPackageLine[]
  quotes         SubcontractQuote[]
  scopeAtoms     ScopeAtom[]
}

model SubcontractPackageLine {
  id                   String @id @default(cuid())
  subcontractPackageId String
  estimateLineId       String
  requiredScope        String
  createdAt            DateTime @default(now())

  subcontractPackage   SubcontractPackage @relation(fields: [subcontractPackageId], references: [id])
  estimateLine         EstimateLine       @relation(fields: [estimateLineId], references: [id])
}

model SubcontractQuote {
  id                   String   @id @default(cuid())
  subcontractPackageId String
  supplierName         String
  totalAmount          Float
  currency             String   @default("GHS")
  receivedAt           DateTime @default(now())
  exclusionsJson       String   @default("[]")
  assumptionsJson      String   @default("[]")
  coveragePct          Float    @default(0) // 0..1 reconciled coverage
  status               String   @default("received") // received | selected | rejected
  createdAt            DateTime @default(now())

  subcontractPackage   SubcontractPackage @relation(fields: [subcontractPackageId], references: [id])
  lines                SubcontractQuoteLine[]
  scopeCoverages       QuoteScopeCoverage[]
}

model SubcontractQuoteLine {
  id              String   @id @default(cuid())
  quoteId         String
  description     String
  amount          Float
  currency        String   @default("GHS")

  quote           SubcontractQuote @relation(fields: [quoteId], references: [id])
}

// P0-7 fix: scope reconciliation based on structured scope atoms, not substring.
// A SubcontractPackage defines required ScopeAtoms (e.g. manufacture, delivery,
// installation). Each quote explicitly covers/excludes each atom.
model ScopeAtom {
  id                   String   @id @default(cuid())
  subcontractPackageId String
  name                 String   // e.g. "installation"
  description          String?
  // P0-1 fix: economic weight for this atom (0..1). Enables economic coverage
  // = sum(covered atom weights) / sum(all atom weights), distinct from semantic
  // coverage = covered atoms / total atoms. If all weights are equal (or 0),
  // economic coverage falls back to semantic coverage.
  valueWeight          Float    @default(0)
  createdAt            DateTime @default(now())

  subcontractPackage   SubcontractPackage @relation(fields: [subcontractPackageId], references: [id])
  coverages            QuoteScopeCoverage[]
}

model QuoteScopeCoverage {
  id            String   @id @default(cuid())
  quoteId       String
  scopeAtomId   String
  // covered | excluded | unstated. 'unstated' = quote didn't address this atom.
  status        String   @default("unstated")
  note          String?
  createdAt     DateTime @default(now())

  quote         SubcontractQuote @relation(fields: [quoteId], references: [id])
  scopeAtom     ScopeAtom        @relation(fields: [scopeAtomId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Bid — submission + outcome (reproducible from immutable revisions)
// ─────────────────────────────────────────────────────────────────────────────

model Bid {
  id                  String   @id @default(cuid())
  organizationId      String
  opportunityId       String   @unique
  estimateId          String   @unique
  estimateRevisionId  String?
  adjudicatedRevisionId String? // P0-4: the revision used for adjudication (must match submitted revision)
  programmeRevisionId String?
  tenderPackStatus    String   @default("draft") // draft | ready | submitted | won | lost | withdrawn
  finalPrice          Float?
  directorAdjustment  Float    @default(0)
  adjustmentRationale String?
  systemSellPrice     Float?   // P0-4: frozen system price at adjudication time (from revision snapshot)
  submittedAt         DateTime?
  outcome             String?  // won | lost | withdrawn | unknown
  lossReason          String?  // price | programme | technical | prequalification | relationship | unknown
  winningPrice        Float?
  ourRank             Int?
  clientFeedback      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id])
  opportunity         Opportunity  @relation(fields: [opportunityId], references: [id])
  estimate            Estimate    @relation(fields: [estimateId], references: [id])
  programmeRevision   ProgrammeRevision? @relation(fields: [programmeRevisionId], references: [id])
  deliverables        TenderDeliverable[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log — append-only
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String   // estimate.created | rate.changed | bid.submitted | etc.
  entityType     String
  entityId       String
  beforeJson     String?
  afterJson      String?
  summary        String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User?        @relation(fields: [actorId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Knowledge Health — stale/unreliable knowledge surfacing
// ─────────────────────────────────────────────────────────────────────────────

model KnowledgeAlert {
  id             String   @id @default(cuid())
  organizationId String
  type           String   // stale-price | productivity-variance | unapproved-rate | scope-gap | subcontract-exclusion
  severity       String   @default("warning") // info | warning | blocker
  title          String
  detail         String?
  entityId       String?
  entityType     String?
  acknowledged   Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Commercial Exceptions (P0-8 fix) — auditable, not a bare boolean.
// An unsourced rate, an incomplete calculation, or any commercial override
// must be recorded with who/when/why and (for high-value) director approval.
// ─────────────────────────────────────────────────────────────────────────────

model CommercialException {
  id              String   @id @default(cuid())
  organizationId  String
  estimateLineId  String?
  entityType      String   // estimate-line | subcontract-quote | assumption
  entityId        String?
  type            String   // unsourced-rate | incomplete-calculation | hybrid-without-allocation | missing-quote | other
  reason          String
  exposure        Float    @default(0) // GHS value at risk
  acknowledgedById String?
  acknowledgedAt  DateTime?
  approvalRequired Boolean @default(false)
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])
  estimateLine    EstimateLine? @relation(fields: [estimateLineId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Knowledge Loop (P1-12) — actuals → variance → calibration proposal
// ─────────────────────────────────────────────────────────────────────────────

model ProjectActual {
  id              String   @id @default(cuid())
  organizationId  String
  estimateLineId  String
  // Actuals captured after execution
  quantityCompleted Float   @default(0)
  daysTaken        Float    @default(0)
  crewSize         Float    @default(0)
  materialConsumed Float    @default(0)
  materialCost     Float    @default(0)
  subcontractFinalCost Float @default(0)
  // Computed variance (planned vs actual)
  plannedProductivity Float  @default(0) // qty / crew-day
  actualProductivity  Float  @default(0)
  productivityVariance Float @default(0) // (actual - planned) / planned
  plannedCost      Float    @default(0)
  actualCost       Float    @default(0)
  costVariance     Float    @default(0) // (actual - planned) / planned
  recordedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])
  estimateLine    EstimateLine @relation(fields: [estimateLineId], references: [id])
  calibrationProposals CalibrationProposal[]
}

model CalibrationProposal {
  id                     String   @id @default(cuid())
  organizationId         String
  workDefinitionId       String
  projectActualId        String?
  type                   String   // productivity-update | price-update | method-update
  currentValue           String
  proposedValue          String
  rationale              String
  status                 String   @default("pending") // pending | approved | rejected | applied
  reviewedById           String?
  reviewedAt             DateTime?
  createdAt              DateTime @default(now())

  organization           Organization @relation(fields: [organizationId], references: [id])
  workDefinition         WorkDefinition @relation(fields: [workDefinitionId], references: [id])
  projectActual          ProjectActual? @relation(fields: [projectActualId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tender Deliverables — explicit document/revision readiness per bid
// ─────────────────────────────────────────────────────────────────────────────

model TenderDeliverable {
  id          String   @id @default(cuid())
  bidId       String
  kind        String   // boq | programme | method-statement | jha | cover-letter | assumptions | clarifications | certificate
  required    Boolean  @default(true)
  status      String   @default("missing") // missing | draft | ready | finalized
  revisionId  String?  // references an EstimateRevision (for programme) or a DocumentVersion (for document-backed kinds)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bid         Bid @relation(fields: [bidId], references: [id])

  @@unique([bidId, kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// Documents — tender document artifacts (method statements, JHAs, BOQs, etc.)
//
// INVARIANT 9: Documents are projections/working copies, not canonical state.
// The Estimate is canonical; documents are assembled FROM the estimate + WDV.
//
// A Document is the per-opportunity, per-kind artifact (e.g. "the method
// statement for Opportunity X"). It has immutable DocumentVersions — each
// finalization creates a new version with an immutable snapshotJson.
//
// When a DocumentVersion is finalized, the linked TenderDeliverable
// (matched by bidId + kind) is updated: status → 'finalized',
// revisionId → DocumentVersion.id. This connects DocumentService to
// BidService's submission gate without modifying BidService.
// ─────────────────────────────────────────────────────────────────────────────

model Document {
  id              String   @id @default(cuid())
  organizationId  String
  opportunityId   String
  kind            String   // boq | method-statement | jha | cover-letter | assumptions | clarifications | certificate
  status          String   @default("missing") // missing | draft | ready | finalized
  currentVersionId String?  // points to the latest finalized DocumentVersion
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  opportunity     Opportunity  @relation(fields: [opportunityId], references: [id])
  versions        DocumentVersion[]

  @@unique([opportunityId, kind]) // one document per kind per opportunity
}

model DocumentVersion {
  id              String    @id @default(cuid())
  documentId      String
  revisionNo      Int       // monotonic per document (1, 2, 3, ...)
  snapshotJson    String    // immutable content + source provenance (WDV IDs, estimate line IDs, assembled body)
  status          String    @default("draft") // draft | finalized — finalized = immutable
  finalizedAt     DateTime?
  finalizedById   String?
  createdAt       DateTime  @default(now())

  document        Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, revisionNo])
}

// ─────────────────────────────────────────────────────────────────────────────
// BOQ Domain — external BOQ import, binding, reconciliation (BOQ Phase 1)
//
// ARCHITECTURE: BoqItem is an OBSERVATION (what the client spreadsheet said),
// NOT canonical commercial state. EstimateLine remains the canonical object
// (INVARIANT 2). They are linked only by an explicit, audited BoqBinding.
//
// Reconciliation is NOT persisted as truth — it is a deterministic pure
// function output (see src/lib/boq/reconcile.ts). The models below store
// the import artifact, the observed rows, and the human-confirmed bindings.
//
// INVARIANT 5: an imported BOQ rate can NEVER silently commit a price.
// INVARIANT 9: the XLSX is a working copy, not canonical state.
// ─────────────────────────────────────────────────────────────────────────────

// One uploaded external workbook. `fileHash` makes the same client workbook
// identifiable across re-uploads even if the filename changes (audit req).
//
// DUPLICATE-HASH SEMANTICS (H3 decision): multiple BoqImports with the same
// (organizationId, fileHash) ARE permitted. A contractor may legitimately
// re-import the same workbook content in different contexts (different
// opportunities, or a re-parse after a format fix). The index is NON-UNIQUE
// by design — it supports lookup/detection, not a uniqueness invariant. The
// application service surfaces prior imports of the same hash via
// findPriorImportsByHash so the operator is AWARE of the re-upload, but it
// does not block it. If a future product decision requires uniqueness, add
// @@unique([organizationId, fileHash]) — but that would prevent legitimate
// re-imports, so it is deliberately not enforced here.
model BoqImport {
  id              String   @id @default(cuid())
  organizationId  String
  opportunityId   String?
  documentId      String?
  fileReference   String   // storage path / key for the uploaded file
  fileName        String
  fileHash        String   // sha256 of file contents — re-upload detection (NON-UNIQUE; see semantics above)
  status          String   @default("pending") // pending | parsed | failed
  source          String   @default("client") // client | consultant | tender-portal | internal | other
  createdAt       DateTime @default(now())
  createdById     String?

  organization    Organization @relation(fields: [organizationId], references: [id])
  items           BoqItem[]

  @@index([organizationId])
  @@index([organizationId, fileHash])
}

// A single row parsed from an external workbook — an OBSERVATION.
// raw* fields preserve the spreadsheet's SEMANTIC content (description/code
// as strings, numeric values coerced to Float for queryability).
// rawCellJson preserves the EXACT original cell representation (the literal
// string/value the spreadsheet held BEFORE any coercion) so the original
// observation can always be reconstructed for audit — e.g. "0012" vs "12.00",
// formula cells, formatted currency strings, locale-specific formatting.
// normalized* fields are our deterministic normalization.
// This row NEVER carries canonical commercial truth.
model BoqItem {
  id                  String   @id @default(cuid())
  boqImportId         String
  worksheet           String
  rowNumber           Int

  // Semantic raw content (coerced for queryability — see rawCellJson for verbatim).
  rawDescription      String
  rawCode             String?
  rawQuantity         Float?
  rawUnit             String?
  rawRate             Float?
  rawAmount           Float?

  // H4: the EXACT original cell representation, as a JSON object mapping
  // column → { value: <original>, formatted: <display string?>, formula: <formula string?> }.
  // Preserves "0012" vs 12 vs "12.00" vs formula cells — audit-grade fidelity.
  rawCellJson         String   @default("{}")

  // Our deterministic normalization (may be null if unparseable).
  normalizedDescription String?
  normalizedCode       String?
  normalizedUnit       String?
  normalizedQuantity   Float?
  normalizedRate       Float?

  currency            String?
  provenanceJson      String   @default("{}") // {source,row,import,timestamp}
  createdAt           DateTime @default(now())

  boqImport           BoqImport @relation(fields: [boqImportId], references: [id])
  binding             BoqBinding?

  @@index([boqImportId])
  @@unique([boqImportId, worksheet, rowNumber])
}

// Identity link between a BoqItem and a canonical EstimateLine.
// Binding answers "which canonical line does this external row refer to?"
// It does NOT answer "do the values match?" (that is reconciliation).
// A binding is an explicit, audited human decision — never an AI auto-bind.
model BoqBinding {
  id                  String   @id @default(cuid())
  boqItemId           String   @unique // 1:1 — one binding per BoqItem
  estimateLineId      String?
  status              String   // MATCHED | AMBIGUOUS | UNMATCHED | REJECTED
  matchMethod         String?  // CODE_EXACT | DESCRIPTION_UNIT_EXACT | WORK_DEFINITION | CANDIDATE_SELECTED | MANUAL
  candidateIdsJson    String   @default("[]") // scored candidate EstimateLine IDs (for AMBIGUOUS)
  confirmedById       String?
  confirmedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  boqItem             BoqItem      @relation(fields: [boqItemId], references: [id])
  estimateLine        EstimateLine? @relation(fields: [estimateLineId], references: [id])

  @@index([estimateLineId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Programme Domain — schedule truth (parallel to EstimateRevision commercial truth)
//
//   Programme = mutable planning workspace
//   ProgrammeRevision = immutable schedule snapshot
//   Activity = planned work with construction-identity relationships
//   ActivityDependency = CPM edge (FS/SS/FF/SF + lag)
//
// INVARIANTS:
//   - ProgrammeRevision is tenant-safe via Programme.organizationId.
//   - Activity references EstimateLine/WorkDefinitionVersion as RELATIONSHIPS,
//     not by copying commercial values.
//   - ProjectActual remains anchored to EstimateLine (not Activity) for v1.
//   - Bid.programmeRevisionId is a real FK to ProgrammeRevision (historical
//     schedule submitted with the bid).
//   - No Calendar, ResourceAssignment, WorkPackage, or ActivityActual yet.
// ─────────────────────────────────────────────────────────────────────────────

model Programme {
  id              String   @id @default(cuid())
  organizationId  String
  opportunityId   String?
  name            String
  status          String   @default("draft") // draft | baseline | superseded
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  revisions       ProgrammeRevision[]
  activities      Activity[]
  dependencies    ActivityDependency[]

  @@index([organizationId])
  @@index([organizationId, opportunityId])
}

model ProgrammeRevision {
  id                   String   @id @default(cuid())
  programmeId          String
  revisionNo           Int
  snapshotJson         String   // immutable schedule-graph snapshot (canonical JSON)
  snapshotContentHash  String   // SHA-256 of the canonical JSON (content identity)
  scheduleEngineVersion Int     // the CPM engine version that computes the schedule
  status               String   @default("draft") // draft | finalized
  finalizedAt          DateTime?
  finalizedById        String?
  createdAt            DateTime @default(now())

  programme            Programme @relation(fields: [programmeId], references: [id])
  bids                 Bid[]

  @@unique([programmeId, revisionNo])
  @@index([programmeId])
}

model Activity {
  id                       String   @id @default(cuid())
  programmeId              String
  name                     String
  duration                 Float    // planned duration in days (finite, >= 0)
  plannedQuantity          Float?   // optional; NOT auto-copied from EstimateLine.quantity
  status                   String   @default("planned") // planned | in-progress | complete
  estimateLineId           String?  // relationship — does NOT carry commercial values
  workDefinitionVersionId  String?  // relationship — construction work identity
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  programme                Programme @relation(fields: [programmeId], references: [id])
  estimateLine             EstimateLine? @relation(fields: [estimateLineId], references: [id])
  workDefinitionVersion    WorkDefinitionVersion? @relation(fields: [workDefinitionVersionId], references: [id])

  // Dependencies where this activity is the predecessor or successor.
  predecessorDependencies  ActivityDependency[] @relation("SuccessorActivity")
  successorDependencies    ActivityDependency[] @relation("PredecessorActivity")

  @@index([programmeId])
  @@index([estimateLineId])
  @@index([workDefinitionVersionId])
}

model ActivityDependency {
  id                    String   @id @default(cuid())
  programmeId           String
  predecessorActivityId String
  successorActivityId   String
  type                  String   // FS | SS | FF | SF
  lag                   Float    @default(0) // days (can be negative = lead)

  programme             Programme @relation(fields: [programmeId], references: [id])
  predecessorActivity   Activity  @relation("PredecessorActivity", fields: [predecessorActivityId], references: [id])
  successorActivity     Activity  @relation("SuccessorActivity", fields: [successorActivityId], references: [id])

  // U1 — DEPENDENCY IDENTITY:
  // A dependency relationship is identified by the ordered pair
  // (predecessor, successor) WITHIN a programme. Between any two activities
  // there is exactly ONE dependency relationship; type and lag are MUTABLE
  // PROPERTIES of that relationship, not part of its identity.
  //
  // This means:
  //   - Adding A→B when A→B already exists (even with a different type/lag)
  //     is REJECTED (409 Conflict). The caller must PATCH the existing edge.
  //   - "Change type" and "change lag" mutate the existing edge rather than
  //     creating a competing one.
  //   - The relationship is ORDERED: A→B ≠ B→A (though the cycle checker
  //     would reject B→A if A→B exists).
  //
  // The previous constraint included `type` in the unique key, which allowed
  // A→B FS and A→B SS to coexist as separate edges — ambiguous authority.
  // type/lag are now properties, not identity.
  @@unique([programmeId, predecessorActivityId, successorActivityId])
  @@index([programmeId])
  @@index([predecessorActivityId])
  @@index([successorActivityId])
}
